package ar.edu.utn.frc.tup.tesis.pinceletas_admin_config_service.controllers;

import ar.edu.utn.frc.tup.tesis.pinceletas_admin_config_service.entities.TerminosCondicionesEntity;
import ar.edu.utn.frc.tup.tesis.pinceletas_admin_config_service.services.TerminosCondicionesService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

import java.util.List;


@RestController
@RequestMapping("/terminos-condiciones")
@RequiredArgsConstructor
public class TerminosCondicionesController {

    private final TerminosCondicionesService politicasService;

    @GetMapping
    public List<TerminosCondicionesEntity> listar() {
        return politicasService.listar();
    }

    @GetMapping("/{id}")
    public TerminosCondicionesEntity obtener(@PathVariable Long id) {
        return politicasService.buscarPorId(id).orElse(null);
    }

    @PostMapping
    public TerminosCondicionesEntity crear(@RequestBody TerminosCondicionesEntity politicas) {
        politicas.setId(null);
        return politicasService.guardar(politicas);
    }

    @PutMapping("/{id}")
    public TerminosCondicionesEntity actualizar(@PathVariable Long id, @RequestBody TerminosCondicionesEntity politicas) {
        politicas.setId(id);
        return politicasService.guardar(politicas);
    }

    @DeleteMapping("/{id}")
    public void eliminar(@PathVariable Long id) {
        politicasService.eliminar(id);
    }

}
