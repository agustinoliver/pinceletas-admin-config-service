package ar.edu.utn.frc.tup.tesis.pinceletas_admin_config_service.controllers;

import ar.edu.utn.frc.tup.tesis.pinceletas_admin_config_service.entities.PoliticasEntity;
import ar.edu.utn.frc.tup.tesis.pinceletas_admin_config_service.services.PoliticasService;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;

import java.util.List;

@RestController
@RequestMapping("/politicas")
@RequiredArgsConstructor
public class PoliticasController {

    private final PoliticasService politicasService;

    @GetMapping
    public List<PoliticasEntity> listar() {
        return politicasService.listar();
    }

    @GetMapping("/{id}")
    public PoliticasEntity obtener(@PathVariable Long id) {
        return politicasService.buscarPorId(id).orElse(null);
    }

    @PostMapping
    public PoliticasEntity crear(@RequestBody PoliticasEntity politicas) {
        return politicasService.guardar(politicas);
    }

    @PutMapping("/{id}")
    public PoliticasEntity actualizar(@PathVariable Long id, @RequestBody PoliticasEntity politicas) {
        politicas.setId(id);
        return politicasService.guardar(politicas);
    }

    @DeleteMapping("/{id}")
    public void eliminar(@PathVariable Long id) {
        politicasService.eliminar(id);
    }

}
